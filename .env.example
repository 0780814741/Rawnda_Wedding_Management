# Copy to .env for LOCAL development only. Never commit .env. All values below are placeholders.
DEBUG=true
SECRET_KEY=change-me-use-a-long-random-string-for-any-non-local-use
# Leave DATABASE_URL empty to use a local SQLite file; for PostgreSQL use:
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/wedding
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

SITE_NAME=Rwanda Wedding Planner
SUPPORT_PHONE=
OPERATOR_EMAIL=
PAYMENT_INSTRUCTIONS=Payment instructions will be provided by our team with your invoice.
# Business parameters (basis points: 100 = 1%). These are PLACEHOLDERS to be set by the operator.
PLATFORM_SERVICE_FEE_BPS=500
VENDOR_COMMISSION_BPS=0
CONTINGENCY_BPS=1000
PRICE_STALE_DAYS=90
DATA_RETENTION_DAYS=730
SHOW_DEMO_VENDORS=true

# Email (console backend prints emails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# Persistent media storage (S3-compatible). Leave empty in local development.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=

# Payments: only "manual" is implemented. Do not set anything else until a real provider is built.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
LOG_LEVEL=INFO
